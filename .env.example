# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database
POSTGRES_DB=anncsu
POSTGRES_USER=anncsu
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Applicazione
APP_NAME=ANNCSU
APP_TIME_ZONE=Europe/Rome
APP_LANGUAGE_CODE=it-it

# LDAP / Active Directory
LDAP_ENABLED=0
LDAP_SERVER_URI=ldap://dc-primary.example.local:389
LDAP_SERVER_URI_BACKUP=ldap://dc-secondary.example.local:389
LDAP_USER_BIND_TEMPLATE={username}@example.local
LDAP_CONNECT_TIMEOUT=5

# PDND
PDND_ENABLED=0
PDND_CLIENT_ID=
PDND_PURPOSE_ID=
PDND_AUDIENCE=
PDND_TOKEN_URL=
PDND_PRIVATE_KEY_PATH=/run/secrets/pdnd_private_key.pem
